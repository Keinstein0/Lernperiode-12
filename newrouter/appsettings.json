{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthNode": {
    "BaseUrl": "http://localhost:5100",
    "ServiceToken": "dev-router-service-token"
  },
  "RouterAuth": {
    "SigningKey": "dev-router-signing-key-change-in-production-32chars!",
    "RegistrationToken": "dev-registration-token",
    "Issuer": "uniskv2-router",
    "Audience": "uniskv2-b2-nodes",
    "TokenLifetimeMinutes": 60
  },
  "Registry": {
    "HeartbeatTimeoutSeconds": 90
  }
}
